{
  "name": "memory-match",
  "version": "1.1.0",
  "private": true,
  "description": "Lật Thẻ — game thẻ bài trí nhớ, monorepo",
  "scripts": {
    "dev": "pnpm --parallel --filter @mm/web --filter @mm/server dev",
    "build": "pnpm --filter @mm/web build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "serve": "node server.js",
    "dev:legacy": "node legacy/v1/server.js 3002",
    "dev:server": "pnpm --filter @mm/server dev",
    "smoke:online": "node tools/smoke-online.mjs",
    "smoke:freeze": "node tools/smoke-freeze.mjs",
    "smoke:offline": "node tools/smoke-offline.mjs",
    "release": "pnpm build && pnpm --filter @mm/server run deploy && node tools/check-share-tags.mjs",
    "check:share": "node tools/check-share-tags.mjs",
    "deploy:server": "pnpm --filter @mm/server run deploy",
    "dev:web": "pnpm --filter @mm/web dev",
    "smoke:chat": "node tools/smoke-chat-limit.mjs",
    "smoke:leave": "node tools/smoke-leave-cancel.mjs",
    "smoke:timer": "node tools/smoke-timer-spectator.mjs",
    "smoke:audit": "node tools/smoke-audit.mjs",
    "smoke:peek": "node tools/smoke-peek.mjs",
    "smoke:options": "node tools/smoke-options.mjs",
    "node:build": "pnpm --filter @mm/node-server build",
    "node:dev": "pnpm build && pnpm --filter @mm/node-server build && cd apps/node-server && WEB_DIR=../../apps/web/dist node dist/server.mjs",
    "docker:build": "docker build -f apps/node-server/Dockerfile -t lat-the-server .",
    "docker:run": "docker run --rm -p 8080:8080 lat-the-server",
    "smoke:kho": "node tools/smoke-kho.mjs",
    "smoke:kick": "node tools/smoke-kick.mjs"
  },
  "packageManager": "pnpm@10.0.0"
}
