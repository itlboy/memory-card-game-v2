{
  "name": "@mm/web",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3001 --strictPort",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --port 3001",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "build:app": "VITE_SERVER_URL=https://flipmatch.cozypi.com vite build && cap sync",
    "build:ios": "VITE_SERVER_URL=https://flipmatch.cozypi.com vite build && cap sync ios",
    "build:android": "VITE_SERVER_URL=https://flipmatch.cozypi.com vite build && cap sync android",
    "ios": "pnpm build:ios && cap open ios",
    "android": "pnpm build:android && cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/splash-screen": "^8",
    "@capgo/capacitor-social-login": "^8",
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/grandstander": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/paytone-one": "^5.3.0",
    "@mm/engine": "workspace:*",
    "lucide-vue-next": "^1.0.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^2.1.9",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.11.6",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0",
    "workbox-window": "^7.4.1"
  }
}
