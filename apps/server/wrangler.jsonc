{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Tên này PHẢI khớp tên worker trên Cloudflare, vì `wrangler deploy` lấy tên
  // từ đây chứ không từ dashboard. Lệch tên là code đi vào worker khác và worker
  // bạn tạo cứ trả 404 mãi.
  "name": "memory-card-game-v2",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",

  // Worker này phục vụ CẢ web đã build lẫn phòng online. Trước đây web nằm ở
  // Cloudflare Pages, worker nằm riêng: hai lần deploy, hai host, và đã hai lần
  // xảy ra chuyện web mới chạy với server cũ vì quên deploy worker.
  //
  // Durable Object BUỘC phải ở Worker, không đặt được trong Pages project
  // ("You cannot create and deploy a Durable Object within a Pages project"),
  // nên gộp theo chiều này chứ không phải chiều ngược lại.
  //
  // Request file tĩnh KHÔNG gọi vào code Worker và Cloudflare không tính phí
  // ("Requests to static assets are free and unlimited"), nên gộp lại không
  // làm tăng chi phí. Tuyệt đối KHÔNG bật Workers Cache: bật là request file
  // tĩnh chuyển thành có phí.
  "assets": {
    "directory": "../web/dist",
    // Đường dẫn không khớp file nào thì trả index.html — app một trang, mọi
    // trạng thái nằm ở query string
    "not_found_handling": "single-page-application",
    // BẮT BUỘC: không có dòng này thì SPA fallback nuốt luôn /api và /ws, trả
    // index.html cho lời gọi API. Danh sách này ép hai nhánh đó vào Worker.
    "run_worker_first": ["/api/*", "/ws/*"]
  },

  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "RoomDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }],
  "observability": { "enabled": true },

  // Môi trường THỬ, tách hẳn khỏi bản người chơi đang dùng.
  //
  // Vì sao cần: Cloudflare không biết gì về nhánh git, nó chỉ nhìn `name`. Mà
  // `name` nằm trong repo nên MỌI nhánh đều mang cùng một tên — deploy từ nhánh
  // đang làm là ghi thẳng lên production. Đổi tên là cách duy nhất để tách.
  //
  // Tên khác ⇒ worker khác ⇒ namespace Durable Object khác, nên phòng chơi ở
  // staging hoàn toàn riêng, thử gì cũng không đụng ai.
  //
  // PHẢI khai lại durable_objects ở đây: wrangler KHÔNG kế thừa khoá này xuống
  // environment (nó cảnh báo "durable_objects is not inherited by environments").
  // Thiếu là staging deploy ra worker không có binding nào — vào phòng là lỗi.
  //
  // Worker có Durable Object thì Cloudflare KHÔNG cấp preview URL, nên đây cũng
  // là cách thay thế duy nhất cho preview theo nhánh.
  "env": {
    "staging": {
      "name": "memory-card-game-v2-staging",
      "durable_objects": {
        "bindings": [{ "name": "ROOM", "class_name": "RoomDO" }]
      }
    }
  }
}
