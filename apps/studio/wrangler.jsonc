{
  // Trang chủ studio Cozy Pi — https://cozypi.com. Chỉ file tĩnh, không có code
  // Worker (request file tĩnh không tính phí). Deploy: `pnpm deploy:studio`.
  //
  // Tách khỏi worker `memory-card-game-v2` vì đây là trang của CẢ studio: app
  // mới chỉ thêm một thẻ vào public/index.html, không đụng tới game nào.
  // Từng app sống ở subdomain riêng (flipmatch.cozypi.com …) qua wildcard
  // *.cozypi.com → tunnel → ingress k8s; custom domain dưới đây đè wildcard
  // cho đúng hai tên apex + www.
  "name": "cozypi-site",
  "compatibility_date": "2025-06-01",
  "assets": { "directory": "./public" },
  "routes": [
    { "pattern": "cozypi.com", "custom_domain": true },
    { "pattern": "www.cozypi.com", "custom_domain": true }
  ]
}
