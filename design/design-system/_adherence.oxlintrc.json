{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/feedback/**",
              "components/game/**",
              "components/nav/**",
              "ui_kits/memory-match-web/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Baloo 2|Nunito))/i]",
        "message": "Font not provided by the design system. Available: Baloo 2, Nunito."
      },
      {
        "selector": "JSXOpeningElement[name.name='BoardCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:symbol|faceUp|matched|wrong|power|blank|key|ref|className|style|children)$/]",
        "message": "<BoardCard> doesn't accept that prop. Declared props: symbol, faceUp, matched, wrong, power, blank."
      },
      {
        "selector": "JSXOpeningElement[name.name='BoardCard'] > JSXAttribute[name.name='power'] > Literal[value!=/^(?:bomb|x2|eye|freeze)$/]",
        "message": "<BoardCard> power must be one of 'bomb' | 'x2' | 'eye' | 'freeze'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|primary|danger|link)$/]",
        "message": "<Button> variant must be one of 'default' | 'primary' | 'danger' | 'link'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CampaignNode'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|cols|rows|stars|locked|onPlay|key|ref|className|style|children)$/]",
        "message": "<CampaignNode> doesn't accept that prop. Declared props: id, cols, rows, stars, locked, onPlay."
      },
      {
        "selector": "JSXOpeningElement[name.name='CardTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:symbol|back|faceUp|matched|wrong|power|blank|dealOrder|disabled|onFlip|style|key|ref|className|style|children)$/]",
        "message": "<CardTile> doesn't accept that prop. Declared props: symbol, back, faceUp, matched, wrong, power, blank, dealOrder, disabled, onFlip, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CardTile'] > JSXAttribute[name.name='back'] > Literal[value!=/^(?:stars|diamond|aurora)$/]",
        "message": "<CardTile> back must be one of 'stars' | 'diamond' | 'aurora'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CardTile'] > JSXAttribute[name.name='power'] > Literal[value!=/^(?:bomb|x2|eye|freeze)$/]",
        "message": "<CardTile> power must be one of 'bomb' | 'x2' | 'eye' | 'freeze'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Celebration'] > JSXAttribute > JSXIdentifier[name!=/^(?:count|seed|key|ref|className|style|children)$/]",
        "message": "<Celebration> doesn't accept that prop. Declared props: count, seed."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|selected|disabled|compact|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: label, hint, selected, disabled, compact, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConfirmDialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|body|confirmLabel|cancelLabel|onConfirm|onCancel|key|ref|className|style|children)$/]",
        "message": "<ConfirmDialog> doesn't accept that prop. Declared props: title, body, confirmLabel, cancelLabel, onConfirm, onCancel."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmojiBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:emojis|onSend|key|ref|className|style|children)$/]",
        "message": "<EmojiBar> doesn't accept that prop. Declared props: emojis, onSend."
      },
      {
        "selector": "JSXOpeningElement[name.name='GridPreview'] > JSXAttribute > JSXIdentifier[name!=/^(?:cols|rows|selected|key|ref|className|style|children)$/]",
        "message": "<GridPreview> doesn't accept that prop. Declared props: cols, rows, selected."
      },
      {
        "selector": "JSXOpeningElement[name.name='HudBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:score|moves|matched|totalPairs|combo|elapsed|timeLeft|movesLeft|lives|levelId|multiplayer|onQuit|key|ref|className|style|children)$/]",
        "message": "<HudBar> doesn't accept that prop. Declared props: score, moves, matched, totalPairs, combo, elapsed, timeLeft, movesLeft, lives, levelId, multiplayer, onQuit."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|style|className|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='OptionTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|selected|layout|icon|title|description|numeral|disabled|role|onClick|style|key|ref|className|style|children)$/]",
        "message": "<OptionTile> doesn't accept that prop. Declared props: tone, selected, layout, icon, title, description, numeral, disabled, role, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='OptionTile'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:g-violet|g-pink|g-cyan|g-blue|g-amber|g-red|g-teal)$/]",
        "message": "<OptionTile> tone must be one of 'g-violet' | 'g-pink' | 'g-cyan' | 'g-blue' | 'g-amber' | 'g-red' | 'g-teal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='OptionTile'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:stack|wide)$/]",
        "message": "<OptionTile> layout must be one of 'stack' | 'wide'."
      },
      {
        "selector": "JSXOpeningElement[name.name='OptionTile'] > JSXAttribute[name.name='role'] > Literal[value!=/^(?:button|checkbox)$/]",
        "message": "<OptionTile> role must be one of 'button' | 'checkbox'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:as|children|style|className|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: as, children, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlayerChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|avatar|score|index|active|lives|turnLeft|frozen|doubleNext|offline|bonus|emoji|key|ref|className|style|children)$/]",
        "message": "<PlayerChip> doesn't accept that prop. Declared props: name, avatar, score, index, active, lives, turnLeft, frozen, doubleNext, offline, bonus, emoji."
      },
      {
        "selector": "JSXOpeningElement[name.name='ResultStat'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|key|ref|className|style|children)$/]",
        "message": "<ResultStat> doesn't accept that prop. Declared props: label, value."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepDots'] > JSXAttribute > JSXIdentifier[name!=/^(?:count|current|key|ref|className|style|children)$/]",
        "message": "<StepDots> doesn't accept that prop. Declared props: count, current."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|onChange|placeholder|code|maxLength|style|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: label, value, onChange, placeholder, code, maxLength, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:info|peek|alert|soft)$/]",
        "message": "<Toast> tone must be one of 'info' | 'peek' | 'alert' | 'soft'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:totalScore|dark|sound|onHome|onToggleDark|onToggleSound|key|ref|className|style|children)$/]",
        "message": "<TopBar> doesn't accept that prop. Declared props: totalScore, dark, sound, onHome, onToggleDark, onToggleSound."
      },
      {
        "selector": "JSXOpeningElement[name.name='TurnBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|avatar|frozenName|key|ref|className|style|children)$/]",
        "message": "<TurnBanner> doesn't accept that prop. Declared props: name, avatar, frozenName."
      },
      {
        "selector": "JSXOpeningElement[name.name='WizardHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|onBack|steps|current|trailing|key|ref|className|style|children)$/]",
        "message": "<WizardHeader> doesn't accept that prop. Declared props: title, onBack, steps, current, trailing."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
