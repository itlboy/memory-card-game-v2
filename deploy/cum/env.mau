# MẪU /opt/latthe/.env — chép thành .env (chmod 600). KHÔNG commit file .env thật.
# Máy phụ dùng CÙNG giá trị với máy chính (chép bằng đường ống, đừng gõ tay / dán vào chat):
#   ssh <máy chính> 'grep -E "^(MYSQL_ROOT_PASSWORD|AUTH_SECRET|TUNNEL_TOKEN|REDIS_PASSWORD)=" /opt/latthe/.env' \
#     | ssh <máy phụ> 'cd /opt/latthe && umask 077 && cat > .env'
# rồi thêm hai dòng IP bên dưới cho máy phụ.

# Mật khẩu root MariaDB (máy chính sinh: openssl rand -hex 24)
MYSQL_ROOT_PASSWORD=thay-bang-chuoi-ngau-nhien
# Khoá ký phiên đăng nhập — PHẢI TRÙNG giữa mọi pod (và với server cũ nếu muốn phiên cũ còn dùng được)
AUTH_SECRET=thay-bang-chuoi-ngau-nhien
# Token tunnel Cloudflare (dashboard Zero Trust → Tunnels) — mọi máy cùng một token
TUNNEL_TOKEN=thay-bang-token-tunnel
# Mật khẩu Redis (máy chính sinh: head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n')
REDIS_PASSWORD=thay-bang-chuoi-ngau-nhien

# IP NỘI BỘ (mạng private TierHive 10.19.106.0/24, xem trên panel)
MAY_CHINH_IP=10.19.106.3
# Chỉ máy phụ cần:
MAY_PHU_IP=10.19.106.2
# Tên máy hiện trên bảng máy chủ admin (mỗi máy một tên)
MAY_TEN=da-2
